# Copy to .envrc or source manually before running npm run start:http.
CODEXPRO_ROOT=/absolute/path/to/your/repo
CODEXPRO_ALLOWED_ROOTS=/absolute/path/to
CODEXPRO_HOST=127.0.0.1
CODEXPRO_PORT=8787
# Comma-separated Host header allowlist. Add your Cloudflare hostname for a named tunnel.
CODEXPRO_ALLOWED_HOSTS=127.0.0.1,localhost,mcp.example.com
# Optional comma-separated cross-origin browser callers. Same-origin requests need no entry.
# CODEXPRO_ALLOWED_ORIGINS=https://client.example.com
CODEXPRO_BASH_MODE=safe
# Optional local bash session guard. If required, bash tool calls must include the matching session_id.
# CODEXPRO_BASH_SESSION_ID=main
# CODEXPRO_REQUIRE_BASH_SESSION=1
CODEXPRO_WRITE_MODE=handoff
# Phase 3A internal kernel. Keep legacy until every supported workspace writer
# is migrated in Phase 3C; atomic mode never falls back to direct writes.
CODEXPRO_FILE_TRANSACTIONS=legacy
CODEXPRO_TOOL_MODE=standard
# Policy migration mode. legacy preserves current execution, shadow compares safely,
# and enforce makes Policy Kernel decisions authoritative and fail-closed.
CODEXPRO_POLICY_ENGINE=legacy
# Persistent local audit. auto is best-effort for legacy/shadow and required
# for enforce-mode R2+ mutations. Audit data remains outside workspaces.
CODEXPRO_AUDIT_MODE=auto
CODEXPRO_AUDIT_RETENTION_DAYS=30
CODEXPRO_AUDIT_RETENTION_BYTES=104857600
# Optional exact local profile id under ~/.codexpro/permissions/<id>.json.
# CODEXPRO_PERMISSION_PROFILE=review
# Dedicated HTTPS origin for ChatGPT widget iframes. Required for app submission.
CODEXPRO_WIDGET_DOMAIN=https://rebel0789.github.io

# Disabled by default so ChatGPT receives plain MCP tool descriptors.
# Set to 1 only if you want CodexPro's custom ChatGPT cards.
CODEXPRO_TOOL_CARDS=0
CODEXPRO_HTTP_TOKEN=[REDACTED_SECRET]
# The supported public CLI uses the personal ChatGPT query-token compatibility flow when this is unset.
# Set to 0 only for an advanced compatible client that can send Authorization: Bearer headers.
# CODEXPRO_ALLOW_QUERY_TOKEN=0
# Require a token even for loopback binds. Non-loopback and tunnel mode require one unless explicitly overridden.
# CODEXPRO_REQUIRE_HTTP_TOKEN=1
# CODEXPRO_ALLOW_NO_HTTP_TOKEN=1
CODEXPRO_CONTEXT_DIR=.ai-bridge
# Idle lifetime for session-scoped workspace handles. Defaults to CODEXPRO_HTTP_SESSION_TTL_MS (30 minutes).
# Minimum 60000, maximum 86400000. Successful use refreshes the idle deadline.
# CODEXPRO_WORKSPACE_TTL_MS=1800000
# Optional stable public URL mode. Quick tunnels do not keep the same hostname.
# CODEXPRO_TUNNEL=cloudflare-named
# CODEXPRO_PUBLIC_HOSTNAME=codexpro.example.com
# CLOUDFLARE_TUNNEL_NAME=codexpro
# Or use a dashboard-managed tunnel token:
# CLOUDFLARE_TUNNEL_TOKEN_FILE=[REDACTED_SECRET]
# Optional comma-separated extra block list:
# CODEXPRO_BLOCKED_GLOBS=**/secrets/**,**/*.sqlite,**/*.db
