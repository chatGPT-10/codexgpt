{
  "name": "codexgpt",
  "version": "1.0.1",
  "description": "Windows-first, self-hosted MCP tools that connect ChatGPT to one local repository through a loopback server and an optional HTTPS tunnel.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chatGPT-10/codexgpt.git"
  },
  "bugs": {
    "url": "https://github.com/chatGPT-10/codexgpt/issues"
  },
  "homepage": "https://rebel0789.github.io/codexgpt/",
  "keywords": [
    "mcp",
    "chatgpt",
    "codex",
    "apps-sdk",
    "codexgpt",
    "local-development",
    "cloudflare-tunnel",
    "ngrok",
    "tailscale"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "docs/*.html",
    "docs/*.js",
    "docs/*.css",
    "docs/*.svg",
    "scripts",
    "README.md",
    "README_ZH.md",
    "PUBLIC_LAUNCH_CHECKLIST.md",
    "DOMAIN_SETUP.md",
    "CLOUDFLARED_VERIFIED_INSTALL.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "FAQ.md",
    "FAQ_ZH.md",
    "CHANGELOG.md",
    "CHATGPT_PROMPT.md",
    "CODEX_PROMPT.md",
    "AGENTS.example.md",
    "config.example.env"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "codexgpt": "scripts/codexgpt-entry.mjs",
    "codexgpt-mcp": "dist/stdio.js",
    "codexgpt-mcp-http": "dist/http.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "start": "node dist/stdio.js",
    "start:stdio": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "dev:stdio": "tsx src/stdio.ts",
    "dev:http": "tsx src/http.ts",
    "smoke": "node scripts/run-smoke.mjs",
    "stress": "npm run build && node scripts/stress-contract-compat.mjs",
    "analysis:smoke": "npm run build && node scripts/analysis-smoke.mjs",
    "analysis:cli-smoke": "npm run build && node scripts/analysis-cli-smoke.mjs",
    "doctor": "node scripts/doctor.mjs",
    "connect": "node scripts/codexgpt-entry.mjs",
    "connect:setup": "node scripts/codexgpt-entry.mjs setup",
    "connect:local": "node scripts/codexgpt-entry.mjs --tunnel none",
    "cloudflared:install": "node scripts/cloudflared-installer.mjs install",
    "cloudflared:upgrade": "node scripts/cloudflared-installer.mjs upgrade",
    "cloudflared:status": "node scripts/cloudflared-installer.mjs status",
    "connect:cloudflare": "node scripts/codexgpt-entry.mjs --tunnel cloudflare",
    "connect:chatgpt": "node scripts/codexgpt-entry.mjs --tunnel cloudflare",
    "connect:stable": "node scripts/codexgpt-entry.mjs --tunnel cloudflare-named",
    "connect:ngrok": "node scripts/codexgpt-entry.mjs ngrok",
    "connect:tailscale": "node scripts/codexgpt-entry.mjs tailscale",
    "pro:bundle": "node scripts/pro-bundle.mjs",
    "pro:apply": "node scripts/pro-apply.mjs",
    "policy:check": "node scripts/repository-policy.mjs",
    "ci:classify": "node scripts/ci-change-classifier.mjs",
    "ci:failure-summary": "npm run build --silent && node scripts/ci-failure-summary.mjs",
    "ci:exact-head": "npm run build --silent && node scripts/exact-head-ci.mjs",
    "task:runner": "node scripts/long-task-runner.mjs",
    "task:run": "node scripts/run-with-cleanup.mjs",
    "task:cleanup": "node scripts/long-task-runner.mjs clean",
    "test:focused": "node scripts/run-with-cleanup.mjs --purpose focused-test -- node --test",
    "native-host:spike": "node scripts/windows-process-host-spike.mjs",
    "native-host:evidence": "node scripts/windows-process-host-spike.mjs --write-evidence",
    "toolchain:status": "node scripts/toolchain-manager.mjs status",
    "toolchain:ensure": "node scripts/toolchain-manager.mjs ensure",
    "toolchain:matrix": "node scripts/toolchain-manager.mjs matrix --major all --",
    "test:ordinary": "node scripts/test-domains.mjs run --domain ordinary",
    "test:control-domain": "node scripts/test-domains.mjs run --domain control"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jose": "6.2.4",
    "minimatch": "^10.0.1",
    "typescript": "5.9.3",
    "yaml": "2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
